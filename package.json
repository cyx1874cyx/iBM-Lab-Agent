{
  "name": "dsh-lab-agent",
  "version": "0.4.0-rc.4",
  "description": "课题组本地科研 Agent（DeepSeek Harness 插件）：Nature Skills 集成、精读目标、PPT 模板、版本登记与回归框架。不修改 Harness 核心。",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./version-registry": {
      "default": "./lib/version-registry.js"
    },
    "./python-env": {
      "default": "./lib/python-env.js"
    },
    "./goal-profiles": {
      "default": "./lib/goal-profiles.js"
    },
    "./note-templates": {
      "default": "./lib/note-templates.js"
    },
    "./experiment-plan-templates": {
      "default": "./lib/experiment-plan-templates.js"
    },
    "./plot-records": {
      "default": "./lib/plot-records.js"
    },
    "./ppt-templates": {
      "default": "./lib/ppt-templates.js"
    },
    "./tasks": {
      "default": "./lib/tasks.js"
    },
    "./literature-sources": {
      "default": "./lib/literature-sources.js"
    },
    "./artifact-download": {
      "default": "./lib/artifact-download.js"
    },
    "./office-preview": {
      "default": "./lib/office-preview.js"
    },
    "./chemistry": {
      "default": "./lib/chemistry.js"
    },
    "./nmr": {
      "default": "./lib/nmr.js"
    },
    "./synthesis": {
      "default": "./lib/synthesis.js"
    },
    "./evidence-shot": {
      "default": "./lib/evidence-shot.js"
    },
    "./user-action": {
      "default": "./lib/user-action.js"
    },
    "./ketcher-assets": {
      "default": "./lib/ketcher-assets.js"
    },
    "./convert-tool": {
      "default": "./lib/convert-tool.js"
    },
    "./memory-tool": {
      "default": "./lib/memory-tool.js"
    },
    "./convert": {
      "default": "./lib/convert.js"
    },
    "./remote": {
      "default": "./lib/remote.js"
    },
    "./llm-diag": {
      "default": "./lib/llm-diag.js"
    },
    "./tasks-tool": {
      "default": "./lib/tasks-tool.js"
    },
    "./manual-capture": {
      "default": "./lib/manual-capture.js"
    },
    "./capture-handoff": {
      "default": "./lib/capture-handoff.js"
    },
    "./templates-tool": {
      "default": "./lib/templates-tool.js"
    },
    "./client": {
      "default": "./client/index.js"
    },
    "./invariant": {
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./synthesis-tool": {
      "default": "./lib/synthesis-tool.js"
    }
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "presets",
    "python",
    "scripts",
    "bin",
    "src",
    "runtime",
    "vendor",
    "tests",
    "docs",
    "install.sh",
    "README.md",
    "vendor.lock.json",
    "harness.lock.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test \"tests/unit/*.test.mjs\" \"tests/integration/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.mjs\"",
    "test:all": "node --test \"tests/unit/*.test.mjs\" \"tests/integration/*.test.mjs\"",
    "test:browser": "node --test \"tests/browser/*.test.mjs\"",
    "test:bridge": "python -m unittest tests/python/test_native_bridge.py",
    "regression": "node scripts/regression/run.mjs",
    "regression:record": "node scripts/regression/run.mjs --record-pass",
    "deploy": "node scripts/install.mjs",
    "doctor": "node scripts/lab-doctor.mjs",
    "dsh:patch": "node scripts/patch-dsh-runtime.mjs",
    "release:linux": "bash scripts/build-linux-release.sh",
    "pin:vendor": "node scripts/pin-vendor.mjs",
    "dev:link": "node scripts/dev-link.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "build:client": "node scripts/build-client.mjs",
    "lint": "eslint lib src scripts tests client browser-extension --max-warnings=200",
    "check:preset-exports": "node scripts/check-preset-exports.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-json": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-app-boot": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-gateway": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-registry": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://git.ustc.edu.cn/qbdeng2025/iBM-Lab-Agent.git"
  },
  "homepage": "https://git.ustc.edu.cn/qbdeng2025/iBM-Lab-Agent",
  "bugs": {
    "url": "https://git.ustc.edu.cn/qbdeng2025/iBM-Lab-Agent/-/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "puppeteer-core": "^24.43.1"
  }
}
