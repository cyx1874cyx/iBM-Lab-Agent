  "files": [
    "lib",
    "plugins/reagents",
    "client",
    "cordis.patch.yml",
    "presets",
    "skills",
    "python",
    "scripts",
    "bin",
    "src",
    "runtime",
    "vendor",
    "tests",
    "docs",
    "install.sh",
    "README.md",
    "vendor.lock.json",
    "harness.lock.json",
    "electron-next"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/lab-research/preset.patch.yml", "./presets/lab-reading/preset.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test \"tests/unit/*.test.mjs\" \"tests/integration/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.mjs\"",
    "test:all": "node --test \"tests/unit/*.test.mjs\" \"tests/integration/*.test.mjs\"",
    "test:browser": "node --test \"tests/browser/*.test.mjs\"",
    "test:bridge": "python -m unittest tests/python/test_native_bridge.py",
    "regression": "node scripts/regression/run.mjs",
    "regression:record": "node scripts/regression/run.mjs --record-pass",
    "deploy": "node scripts/install.mjs",
    "doctor": "node scripts/lab-doctor.mjs",
    "dsh:patch": "node scripts/patch-dsh-runtime.mjs",
    "release:linux": "bash scripts/build-linux-release.sh",
    "pin:vendor": "node scripts/pin-vendor.mjs",
    "dev:link": "node scripts/dev-link.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "build:client": "node scripts/build-client.mjs",
    "build:rag": "node scripts/build-rag.mjs",
    "dev:workbench": "node scripts/dev-workbench.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "check:plugins": "node scripts/verify-plugins.mjs",
    "check:decoupling": "node scripts/check-decoupling.mjs",
    "build:plugins": "node scripts/build-plugin-clients.mjs",
    "check:plugin-clients": "node scripts/build-plugin-clients.mjs --check",
    "plugins:register": "node scripts/register-plugins.mjs",
    "smoke:plugins": "node scripts/smoke-plugin-packages.mjs",
    "lint": "eslint lib src scripts tests client browser-extension --max-warnings=200",
    "check:preset-exports": "node scripts/check-preset-exports.mjs"
  },
