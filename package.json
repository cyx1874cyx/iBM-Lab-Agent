{
  "name": "dsh-lab-agent",
  "version": "0.1.0",
  "description": "课题组本地科研 Agent（DeepSeek Harness 插件）：Nature Skills 集成、精读目标、PPT 模板、版本登记与回归框架。不修改 Harness 核心。",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./version-registry": {
      "types": "./lib/types/version-registry.d.ts",
      "default": "./lib/version-registry.js"
    },
    "./python-env": {
      "types": "./lib/types/python-env.d.ts",
      "default": "./lib/python-env.js"
    },
    "./goal-profiles": {
      "types": "./lib/types/goal-profiles.d.ts",
      "default": "./lib/goal-profiles.js"
    },
    "./ppt-templates": {
      "types": "./lib/types/ppt-templates.d.ts",
      "default": "./lib/ppt-templates.js"
    },
    "./tasks": {
      "types": "./lib/types/tasks.d.ts",
      "default": "./lib/tasks.js"
    },
    "./chemistry": {
      "types": "./lib/types/chemistry.d.ts",
      "default": "./lib/chemistry.js"
    },
    "./nmr": {
      "types": "./lib/types/nmr.d.ts",
      "default": "./lib/nmr.js"
    },
    "./synthesis": {
      "types": "./lib/types/synthesis.d.ts",
      "default": "./lib/synthesis.js"
    },
    "./convert-tool": {
      "types": "./lib/types/convert-tool.d.ts",
      "default": "./lib/convert-tool.js"
    },
    "./memory-tool": {
      "default": "./lib/memory-tool.js"
    },
    "./convert": {
      "types": "./lib/types/convert.d.ts",
      "default": "./lib/convert.js"
    },
    "./remote": {
      "types": "./lib/types/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./client": {
      "default": "./client/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "presets",
    "python",
    "scripts",
    "src",
    "vendor",
    "tests",
    "docs",
    "README.md",
    "vendor.lock.json",
    "harness.lock.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.mjs\"",
    "test:all": "node --test \"tests/unit/*.test.mjs\" \"tests/integration/*.test.mjs\"",
    "regression": "node scripts/regression/run.mjs",
    "regression:record": "node scripts/regression/run.mjs --record-pass",
    "deploy": "node scripts/install.mjs",
    "pin:vendor": "node scripts/pin-vendor.mjs",
    "dev:link": "node scripts/dev-link.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-storage-domain": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-storage-json": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-storage": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-app-boot": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-api-gateway": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-typert-registry": "^0.1.0-rc.7"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lab/dsh-lab-agent.git"
  }
}
