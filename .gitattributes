.gitattributes text eol=lf
*.sh text eol=lf
bin/ibm-lab-agent text eol=lf
*.mjs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env text eol=lf
*.lock text eol=lf
# Cargo/tauri 构建会重写 .toml（内容不变，但行尾可能落成 LF）。不声明的话
# core.autocrlf=true 会把它判成"工作树脏"，使 desktop 发布预检直接拒绝构建。
*.toml text eol=lf
# apt-packages.txt 等 .txt 由 Linux 安装器用 bash `mapfile` 逐行读成包名；一旦被
# checkout 成 CRLF，包名会带 \r 使 apt 安装失败。仓库里 7 个 .txt 的已提交内容全是
# LF，声明 eol=lf 不引发 renormalize，只防止 Windows 侧（core.autocrlf=true）写成 CRLF。
*.txt text eol=lf
# 注意：*.ps1 刻意**不**声明 eol。Windows PowerShell 5.1 按系统 ANSI 代码页（本机 GBK）
# 读取脚本，含中文注释的无 BOM UTF-8 脚本若为 LF 行尾，中文尾字节会吞掉换行、把下一行
# 代码并进注释，报出误导性的 `unexpected token "}"`（实测 build-windows-release.ps1）。
# 防线是给这类文件加 UTF-8 BOM（与行尾无关，见 tests/unit/powershell-source-encoding.test.mjs），
# 而不是 eol=lf —— 后者会把隐患带到每台机器的每次检出。
