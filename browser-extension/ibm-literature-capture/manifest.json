{
  "manifest_version": 3,
  "name": "iBM Lab 文献捕获",
  "version": "0.5.2",
  "key": "",
  "description": "iBM Lab Agent 桌面应用专用下载桥：监听已布防的 PDF/SI 下载，并归档到对应课题。",
  "minimum_chrome_version": "102",
  "permissions": ["downloads", "storage", "nativeMessaging"],
  "host_permissions": [
    "http://127.0.0.1/lab/capture/*",
    "http://localhost/lab/capture/*"
  ],
  "content_scripts": [{
    "matches": [
      "http://127.0.0.1/lab/capture/*",
      "http://localhost/lab/capture/*"
    ],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": false
  }],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "iBM Lab 文献捕获"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
