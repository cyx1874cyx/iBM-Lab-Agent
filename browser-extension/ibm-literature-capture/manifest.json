{
  "manifest_version": 3,
  "name": "iBM Lab 文献捕获",
  "version": "0.4.0",
  "description": "为 iBM Lab Agent 捕获用户明确布防的文献下载，并通过本地桥接安全保存已审核的 PPTX/DOCX。只处理用户主动发起的任务，不读取 Cookie、历史或其他文件。",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "downloads", "storage", "nativeMessaging", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "iBM Lab 文献捕获"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
