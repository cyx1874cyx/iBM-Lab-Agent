{
  "name": "dsh-lab-ui",
  "version": "0.5.8-rc.1",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./client/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "client",
    "preset.patch.yml"
  ],
  "dependencies": {
    "dsh-lab-agent": "0.5.8-rc.1"
  },
  "peerDependencies": {
    "dsh-lab-core": "0.5.8-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./preset.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  }
}
