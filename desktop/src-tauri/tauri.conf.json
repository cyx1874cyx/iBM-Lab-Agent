{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iBM Lab Agent",
  "version": "0.1.6",
  "identifier": "cn.ustc.ibm-lab-agent",
  "build": { "frontendDist": "../src" },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "iBM Lab Agent",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/node/": "node/",
      "resources/dsh/": "dsh/",
      "resources/plugin/": "plugin/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "startMenuFolder": "iBM Lab Agent"
      }
    }
  }
}
